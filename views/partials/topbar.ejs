<header class="aucp-topbar">
  <div class="aucp-topbar-title">
    <%= pageHeader || 'Portal Dashboard' %>
  </div>

  <div class="aucp-topbar-search">
    <form action="/buyer/browse" method="GET" style="margin: 0;">
      <span class="aucp-topbar-search-icon"><i class="ti ti-search"></i></span>
      <input type="text" name="q" placeholder="Search for items, categories, or listings..." aria-label="Search auctions">
    </form>
  </div>

  <div class="aucp-topbar-user">
    <% if (currentUser) { %>
      <div class="aucp-user-badge">
        <span><i class="ti ti-user" style="vertical-align: middle;"></i> <strong><%= currentUser.name %></strong></span>
        <span class="aucp-role-chip <%= currentUser.role === 'admin' ? 'aucp-role-admin' : 'aucp-role-user' %>">
          <%= currentUser.role === 'admin' ? 'Admin' : 'Member' %>
        </span>
      </div>
      <a href="/logout" class="aucp-btn aucp-btn-outline aucp-btn-sm">Sign Out</a>
    <% } else { %>
      <a href="/login" class="aucp-btn aucp-btn-outline aucp-btn-sm">Log In</a>
      <a href="/register" class="aucp-btn aucp-btn-primary aucp-btn-sm">Register</a>
    <% } %>
  </div>
</header>
