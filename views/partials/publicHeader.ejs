<header style="height: 80px; border-bottom: 1px solid var(--aucp-border); padding: 0 40px; display: flex; align-items: center; justify-content: space-between; background-color: #080A0F; position: sticky; top: 0; z-index: 1000;">
  <div style="display: flex; align-items: center; gap: 32px;">
    <a href="/" style="font-size: 22px; font-weight: 800; color: #FFFFFF; display: flex; align-items: center; gap: 8px;">
      🛡️ <span style="color: var(--aucp-text-primary);">BidSecure</span>
    </a>

    <nav style="display: flex; gap: 24px; font-weight: 600; font-size: 14px;">
      <a href="/" style="color: <%= activeTab === 'home' ? 'var(--aucp-primary)' : 'var(--aucp-text-secondary)' %>;">Home</a>
      <a href="/buyer/browse" style="color: <%= activeTab === 'browse' ? 'var(--aucp-primary)' : 'var(--aucp-text-secondary)' %>;">Browse Marketplace</a>
      <a href="/how-it-works" style="color: <%= activeTab === 'how-it-works' ? 'var(--aucp-primary)' : 'var(--aucp-text-secondary)' %>;">Security & FAQs</a>
    </nav>
  </div>

  <!-- Header Search Input -->
  <div class="aucp-topbar-search" style="max-width: 380px;">
    <form action="/buyer/browse" method="GET" style="margin: 0;">
      <span class="aucp-topbar-search-icon">🔍</span>
      <input type="text" name="q" placeholder="Search title, category, drop..." aria-label="Search auctions" value="<%= typeof query !== 'undefined' && query && query.q ? query.q : '' %>">
    </form>
  </div>

  <div style="display: flex; align-items: center; gap: 16px;">
    <% if (currentUser) { %>
      <div class="aucp-user-badge">
        <span>👤 <strong><%= currentUser.name %></strong></span>
      </div>
      <a href="<%= currentUser.role === 'admin' ? '/admin/dashboard' : '/buyer/dashboard' %>" class="aucp-btn aucp-btn-primary aucp-btn-sm">
        My Dashboard &rarr;
      </a>
      <a href="/logout" class="aucp-btn aucp-btn-outline aucp-btn-sm">Sign Out</a>
    <% } else { %>
      <a href="/login" class="aucp-btn aucp-btn-outline aucp-btn-sm">Sign In</a>
      <a href="/register" class="aucp-btn aucp-btn-primary aucp-btn-sm">Register Account</a>
    <% } %>
  </div>
</header>
