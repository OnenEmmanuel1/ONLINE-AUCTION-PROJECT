<%- include('./partials/head', { title: 'BidSecure – One Drop. One Winner. Will It Be You?' }) %>

<div style="background-color: var(--aucp-bg); min-height: 100vh; display: flex; flex-direction: column;">

  <!-- Public Top Navigation Header (Full-width public header, NO sidebar) -->
  <%- include('./partials/publicHeader', { activeTab: 'home' }) %>

  <!-- High-Energy Hero Section (Image 3 Left Banner Style) -->
  <section style="padding: 48px 40px; max-width: 1300px; margin: 0 auto; width: 100%;">
    <div class="aucp-card" style="background-color: #121722; border-color: var(--aucp-border); padding: 40px; border-radius: 20px; display: grid; grid-template-columns: 1fr 440px; gap: 40px; align-items: center;">
      
      <div>
        <div style="display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; background-color: var(--aucp-primary-light); border-radius: 20px; color: var(--aucp-primary); font-weight: 700; font-size: 13px; margin-bottom: 20px;">
          <i class="ti ti-hand-click" style="vertical-align: middle;"></i> Welcome to BidSecure Calabar
        </div>

        <h1 style="font-size: 46px; font-weight: 900; line-height: 1.15; color: #FFFFFF; margin-bottom: 16px; letter-spacing: -0.5px;">
          One Drop. One Winner. <br>
          <span style="color: var(--aucp-primary);">Will It Be You?</span>
        </h1>

        <p style="font-size: 16px; color: var(--aucp-text-secondary); max-width: 540px; margin-bottom: 32px; line-height: 1.6;">
          Calabar's security-focused online auction portal. Authenticated listings, real-time bid validation, AES-256-GCM encryption, and rule-based fraud detection.
        </p>

        <div style="display: flex; gap: 16px;">
          <a href="/buyer/browse" class="aucp-btn aucp-btn-primary" style="padding: 14px 28px; font-size: 16px;">
            Explore Live Auctions &rarr;
          </a>
          <a href="/register" class="aucp-btn aucp-btn-outline" style="padding: 14px 24px; font-size: 16px;">
            Join & Verify Account
          </a>
        </div>
      </div>

      <!-- Featured Spotlight Card (Image 3 Drop Spotlight Card with real item image) -->
      <% if (featuredItem) { %>
        <div style="background-color: #171D2A; border: 1px solid var(--aucp-border-dark); border-radius: 16px; overflow: hidden; padding: 20px;">
          <div style="position: relative; width: 100%; height: 260px; background-color: #080A0F; border-radius: 12px; overflow: hidden; margin-bottom: 16px;">
            <% if (featuredItem.image_filename) { %>
              <img src="<%= featuredItem.image_filename.startsWith('http') ? featuredItem.image_filename : '/uploads/listings/' + featuredItem.image_filename %>" alt="<%= featuredItem.title %>" style="width: 100%; height: 100%; object-fit: cover;">
            <% } else { %>
              <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--aucp-text-muted);">
                <i class="ti ti-photo" style="font-size: 48px;"></i>
              </div>
            <% } %>

            <div class="aucp-timer-pill-overlay">
              <i class="ti ti-clock-play" style="vertical-align: middle;"></i> LIVE DROP SPOTLIGHT
            </div>
          </div>

          <span class="aucp-badge" style="background:#1E293B; color:#94A3B8; margin-bottom: 8px;"><%= featuredItem.category %></span>
          <h3 style="font-size: 18px; font-weight: 800; color: #FFFFFF; margin-bottom: 12px;"><%= featuredItem.title %></h3>

          <div style="display: flex; justify-content: space-between; align-items: center; background-color: #0B0E14; padding: 12px 16px; border-radius: 8px; margin-bottom: 16px;">
            <div>
              <div style="font-size: 10px; text-transform: uppercase; font-weight: 700; color: var(--aucp-text-muted);">CURRENT HIGHEST BID</div>
              <div style="font-size: 20px; font-weight: 800; color: var(--aucp-primary);">
                ₦<%= parseFloat(featuredItem.current_highest_bid).toLocaleString('en-NG', { minimumFractionDigits: 2 }) %>
              </div>
            </div>
            <a href="/buyer/auction/<%= featuredItem.id %>" class="aucp-btn aucp-btn-primary aucp-btn-sm">
              Place Bid
            </a>
          </div>
        </div>
      <% } %>

    </div>
  </section>

  <!-- All Categories Grid Section (Image 3 "All Categories" Tile Grid) -->
  <section style="padding: 32px 40px; max-width: 1300px; margin: 0 auto; width: 100%;">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 24px;">
      <div>
        <h2 style="font-size: 26px; font-weight: 900; color: #FFFFFF;">All Categories</h2>
        <p style="font-size: 14px; color: var(--aucp-text-secondary); margin-top: 4px;">Browse verified auction items by category across Calabar</p>
      </div>
      <a href="/buyer/browse" style="font-weight: 700; color: var(--aucp-primary);">View All Categories &rarr;</a>
    </div>

    <div class="aucp-category-grid" style="grid-template-columns: repeat(4, 1fr);">
      <a href="/buyer/browse?category=Art+%26+Antiques" class="aucp-category-tile">
        <span class="aucp-category-icon"><i class="ti ti-palette"></i></span>
        <span class="aucp-category-name">Art & Antiques</span>
      </a>

      <a href="/buyer/browse?category=Electronics" class="aucp-category-tile">
        <span class="aucp-category-icon"><i class="ti ti-device-mobile"></i></span>
        <span class="aucp-category-name">Electronics</span>
      </a>

      <a href="/buyer/browse?category=Vehicles" class="aucp-category-tile">
        <span class="aucp-category-icon"><i class="ti ti-car"></i></span>
        <span class="aucp-category-name">Vehicles</span>
      </a>

      <a href="/buyer/browse?category=Cultural+Artifacts" class="aucp-category-tile">
        <span class="aucp-category-icon"><i class="ti ti-building-monument"></i></span>
        <span class="aucp-category-name">Cultural Artifacts</span>
      </a>

      <a href="/buyer/browse?category=Home+Appliances" class="aucp-category-tile">
        <span class="aucp-category-icon"><i class="ti ti-snowflake"></i></span>
        <span class="aucp-category-name">Home Appliances</span>
      </a>

      <a href="/buyer/browse?category=Computers" class="aucp-category-tile">
        <span class="aucp-category-icon"><i class="ti ti-device-laptop"></i></span>
        <span class="aucp-category-name">Computers</span>
      </a>

      <a href="/buyer/browse?category=Fashion+%26+Jewelry" class="aucp-category-tile">
        <span class="aucp-category-icon"><i class="ti ti-shoe"></i></span>
        <span class="aucp-category-name">Fashion & Jewelry</span>
      </a>

      <a href="/buyer/browse?category=Real+Estate+%26+Property" class="aucp-category-tile">
        <span class="aucp-category-icon"><i class="ti ti-building"></i></span>
        <span class="aucp-category-name">Real Estate</span>
      </a>
    </div>
  </section>

  <!-- Auctions For You / Live Discovery Section -->
  <section style="padding: 32px 40px 64px 40px; max-width: 1300px; margin: 0 auto; width: 100%;">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 24px;">
      <div>
        <h2 style="font-size: 26px; font-weight: 900; color: #FFFFFF;">Auctions <span style="color: var(--aucp-primary);">For You</span></h2>
        <p style="font-size: 14px; color: var(--aucp-text-secondary); margin-top: 4px;">Live bidding drops currently active on the platform</p>
      </div>
      <a href="/buyer/browse" class="aucp-btn aucp-btn-outline aucp-btn-sm">Browse All Marketplace Drops</a>
    </div>

    <div class="aucp-grid-3">
      <% if (liveAuctions.length === 0) { %>
        <div style="grid-column: span 3; text-align: center; color: var(--aucp-text-muted); padding: 48px; background: var(--aucp-surface); border-radius: 12px;">
          No live auctions available right now. Check back soon!
        </div>
      <% } else { %>
        <% liveAuctions.forEach(item => { %>
          <div class="aucp-item-card">
            <div class="aucp-item-img-container">
              <% if (item.image_filename) { %>
                <img src="<%= item.image_filename.startsWith('http') ? item.image_filename : '/uploads/listings/' + item.image_filename %>" alt="<%= item.title %>" class="aucp-item-img">
              <% } else { %>
                <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; color: var(--aucp-text-muted);">
                  <i class="ti ti-photo" style="font-size: 40px;"></i>
                </div>
              <% } %>
              <div style="position:absolute; top:10px; right:10px;">
                <span class="aucp-badge aucp-badge-live">LIVE NOW</span>
              </div>
            </div>

            <div style="margin-bottom: 8px;">
              <span class="aucp-badge" style="background:#1E293B; color:#94A3B8;"><%= item.category %></span>
            </div>

            <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 8px; color: var(--aucp-text-primary);">
              <a href="/buyer/auction/<%= item.id %>"><%= item.title %></a>
            </h3>

            <div style="background: #171D2A; padding: 12px; border-radius: var(--aucp-radius-sm); margin-top: auto; margin-bottom: 14px; border: 1px solid var(--aucp-border);">
              <div style="font-size: 11px; text-transform: uppercase; color: var(--aucp-text-muted); font-weight: 700;">Current Highest Bid</div>
              <div style="font-size: 20px; font-weight: 800; color: var(--aucp-primary);">
                ₦<%= parseFloat(item.current_highest_bid).toLocaleString('en-NG', { minimumFractionDigits: 2 }) %>
              </div>
              <div style="font-size: 11px; color: var(--aucp-text-secondary); margin-top: 4px;">
                Seller: <strong><%= item.seller_name %></strong>
              </div>
            </div>

            <a href="/buyer/auction/<%= item.id %>" class="aucp-btn aucp-btn-primary aucp-btn-block">
              Place Bid &rarr;
            </a>
          </div>
        <% }); %>
      <% } %>
    </div>
  </section>

  <!-- Dedicated Footer -->
  <footer class="aucp-footer">
    <div style="max-width: 1300px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center;">
      <div>
        <strong>BidSecure Calabar</strong> — Security-Focused Online Auction Portal
      </div>
      <div style="display: flex; gap: 20px;">
        <a href="/" style="color: var(--aucp-text-muted);">Home</a>
        <a href="/buyer/browse" style="color: var(--aucp-text-muted);">Browse</a>
        <a href="/how-it-works" style="color: var(--aucp-text-muted);">How It Works</a>
        <a href="/login" style="color: var(--aucp-text-muted);">Sign In</a>
      </div>
    </div>
  </footer>

</div>

</body>
</html>
