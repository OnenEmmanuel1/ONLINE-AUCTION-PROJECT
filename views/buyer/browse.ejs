<%- include('../partials/head', { title: 'Browse Auctions – BidSecure' }) %>

<div style="background-color: var(--aucp-bg); min-height: 100vh; display: flex; flex-direction: column;">

  <!-- Full-Width Public Header Navigation (NO sidebar format) -->
  <%- include('../partials/publicHeader', { activeTab: 'browse', query }) %>

  <main style="padding: 40px; max-width: 1300px; margin: 0 auto; width: 100%; flex-grow: 1;">

    <!-- Category Filter Tiles (Image 3 Style) -->
    <div style="margin-bottom: 32px;">
      <h2 style="font-size: 22px; font-weight: 900; color: #FFFFFF; margin-bottom: 16px;">All Marketplace Categories</h2>
      <div class="aucp-category-grid" style="grid-template-columns: repeat(4, 1fr);">
        <a href="/buyer/browse?category=Art+%26+Antiques" class="aucp-category-tile">
          <span class="aucp-category-icon">🎨</span>
          <span class="aucp-category-name">Art & Antiques</span>
        </a>
        <a href="/buyer/browse?category=Electronics" class="aucp-category-tile">
          <span class="aucp-category-icon">📱</span>
          <span class="aucp-category-name">Electronics</span>
        </a>
        <a href="/buyer/browse?category=Vehicles" class="aucp-category-tile">
          <span class="aucp-category-icon">🚗</span>
          <span class="aucp-category-name">Vehicles</span>
        </a>
        <a href="/buyer/browse?category=Cultural+Artifacts" class="aucp-category-tile">
          <span class="aucp-category-icon">🗿</span>
          <span class="aucp-category-name">Cultural Artifacts</span>
        </a>
      </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="aucp-card">
      <form action="/buyer/browse" method="GET" class="aucp-grid-3" style="margin-bottom: 0; align-items: flex-end;">
        <div class="aucp-form-group" style="margin-bottom: 0;">
          <label class="aucp-form-label" for="search">Keyword Search</label>
          <input type="text" id="search" name="q" class="aucp-form-input" placeholder="Search title or description..." value="<%= query.q || '' %>">
        </div>

        <div class="aucp-form-group" style="margin-bottom: 0;">
          <label class="aucp-form-label" for="category">Category Filter</label>
          <select id="category" name="category" class="aucp-form-select">
            <option value="">All Categories</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>" <%= query.category === cat ? 'selected' : '' %>><%= cat %></option>
            <% }); %>
          </select>
        </div>

        <div style="display: flex; gap: 10px;">
          <button type="submit" class="aucp-btn aucp-btn-primary" style="flex-grow: 1;">
            Apply Filters
          </button>
          <% if (query.q || query.category) { %>
            <a href="/buyer/browse" class="aucp-btn aucp-btn-outline">Reset</a>
          <% } %>
        </div>
      </form>
    </div>

    <!-- Marketplace Listings Cards Grid with Real Images (Image 2/3 style) -->
    <div style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center;">
      <h2 style="font-size: 22px; font-weight: 900; color: #FFFFFF;">
        Available Bidding Drops (<%= listings.length %>)
      </h2>
    </div>

    <div class="aucp-grid-3">
      <% if (listings.length === 0) { %>
        <div class="aucp-card" style="grid-column: span 3; text-align: center; padding: 48px;">
          <h3 style="font-size: 18px; color: var(--aucp-text-secondary);">No active auctions match your search criteria.</h3>
          <p style="color: var(--aucp-text-muted); margin-top: 8px;">Try selecting a different category or resetting search filters.</p>
        </div>
      <% } else { %>
        <% listings.forEach(item => { %>
          <div class="aucp-item-card">
            <div class="aucp-item-img-container">
              <% if (item.image_filename) { %>
                <img src="<%= item.image_filename.startsWith('http') ? item.image_filename : '/uploads/listings/' + item.image_filename %>" alt="<%= item.title %>" class="aucp-item-img">
              <% } else { %>
                <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-size:40px; color: var(--aucp-text-muted);">
                  🖼️
                </div>
              <% } %>
              <div style="position:absolute; top:10px; right:10px;">
                <span class="aucp-badge aucp-badge-live">LIVE NOW</span>
              </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
              <span class="aucp-badge" style="background:#1E293B; color:#94A3B8;"><%= item.category %></span>
            </div>

            <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 8px; color: var(--aucp-text-primary);">
              <a href="/buyer/auction/<%= item.id %>"><%= item.title %></a>
            </h3>

            <p style="font-size: 13px; color: var(--aucp-text-secondary); margin-bottom: 16px; flex-grow: 1;">
              <%= item.description.length > 90 ? item.description.substring(0, 90) + '...' : item.description %>
            </p>

            <div style="background: #171D2A; padding: 12px; border-radius: var(--aucp-radius-sm); margin-bottom: 16px; border: 1px solid var(--aucp-border);">
              <div style="font-size: 11px; text-transform: uppercase; color: var(--aucp-text-muted); font-weight: 700;">Current Highest Bid</div>
              <div style="font-size: 22px; font-weight: 800; color: var(--aucp-primary);">
                ₦<%= parseFloat(item.current_highest_bid) > 0 ? parseFloat(item.current_highest_bid).toLocaleString('en-NG', { minimumFractionDigits: 2 }) : parseFloat(item.starting_price).toLocaleString('en-NG', { minimumFractionDigits: 2 }) %>
              </div>
              <div style="font-size: 11px; color: var(--aucp-text-secondary); margin-top: 4px;">
                Seller: <strong><%= item.seller_name %></strong>
              </div>
            </div>

            <a href="/buyer/auction/<%= item.id %>" class="aucp-btn aucp-btn-primary aucp-btn-block">
              View & Bid &rarr;
            </a>
          </div>
        <% }); %>
      <% } %>
    </div>
  </main>

  <footer class="aucp-footer">
    <div style="max-width: 1300px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center;">
      <div>
        <strong>BidSecure Calabar</strong> — Security-Focused Online Auction Portal
      </div>
      <div style="display: flex; gap: 20px;">
        <a href="/" style="color: var(--aucp-text-muted);">Home</a>
        <a href="/buyer/browse" style="color: var(--aucp-text-muted);">Browse</a>
        <a href="/how-it-works" style="color: var(--aucp-text-muted);">How It Works</a>
        <a href="/login" style="color: var(--aucp-text-muted);">Sign In</a>
      </div>
    </div>
  </footer>
</div>
