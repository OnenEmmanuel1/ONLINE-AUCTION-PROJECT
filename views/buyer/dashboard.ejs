<%- include('../partials/head', { title: 'Buyer Dashboard – BidSecure' }) %>

<div class="aucp-layout">
  <%- include('../partials/sidebarBuyer', { activeTab: 'dashboard' }) %>

  <div class="aucp-main-wrapper">
    <%- include('../partials/topbar', { pageHeader: 'Live Auction Dashboard' }) %>

    <div class="aucp-content">

      <% if (queryVerify === 'required') { %>
        <div class="aucp-alert aucp-alert-warning">
          <strong>Identity Profile Required:</strong> Please ensure your full name, phone contact, and address are filled out before placing bids.
        </div>
      <% } %>

      <!-- Top Summary Metrics Panel (Image 1 statistics panel style) -->
      <div class="aucp-grid-4">
        <div class="aucp-stat-card">
          <div class="aucp-stat-label">Active Bids Placed</div>
          <div class="aucp-stat-value"><%= stats.activeBidsCount %></div>
          <div class="aucp-stat-subtext">Auctions currently bidding on</div>
        </div>

        <div class="aucp-stat-card">
          <div class="aucp-stat-label">Won Auctions</div>
          <div class="aucp-stat-value" style="color: var(--aucp-secondary);"><%= stats.wonCount %></div>
          <div class="aucp-stat-subtext">Auctions won & settled</div>
        </div>

        <div class="aucp-stat-card">
          <div class="aucp-stat-label">Total Outlay</div>
          <div class="aucp-stat-value">₦<%= stats.totalSpent.toLocaleString('en-NG', { minimumFractionDigits: 2 }) %></div>
          <div class="aucp-stat-subtext">Settled purchases total</div>
        </div>

        <div class="aucp-stat-card">
          <div class="aucp-stat-label">Account Verification</div>
          <div class="aucp-stat-value" style="font-size: 20px;">
            <% if (currentUser.account_status === 'active') { %>
              <span class="aucp-badge aucp-badge-active">Verified Active</span>
            <% } else { %>
              <span class="aucp-badge aucp-badge-unsold">Suspended</span>
            <% } %>
          </div>
          <div class="aucp-stat-subtext">Calabar Security Node Checked</div>
        </div>
      </div>

      <!-- Featured Hero Auction Card (Image 1 Style) -->
      <% if (liveAuctions && liveAuctions.length > 0) { %>
        <% const heroItem = liveAuctions[0]; %>
        <div class="aucp-hero-card">
          <div class="aucp-hero-img-box">
            <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; color: var(--aucp-text-muted);">
              <i class="ti ti-photo" style="font-size: 48px;"></i>
            </div>
            <div class="aucp-timer-pill-overlay">
              <i class="ti ti-clock-play" style="vertical-align: middle;"></i> LIVE AUCTION
            </div>
          </div>

          <div style="display:flex; flex-direction:column; justify-content:center;">
            <div style="display:flex; gap:10px; align-items:center; margin-bottom: 10px;">
              <span class="aucp-badge" style="background:#1E293B; color:#94A3B8;"><%= heroItem.category %></span>
              <span class="aucp-badge aucp-badge-live">HOT FEATURED</span>
            </div>

            <h1 style="font-size: 24px; font-weight: 800; color: var(--aucp-text-primary); margin-bottom: 8px;">
              <%= heroItem.title %>
            </h1>

            <div style="font-size: 13px; color: var(--aucp-text-secondary); margin-bottom: 20px;">
              Seller: <strong><%= heroItem.seller_name %></strong> &bull; Ends: <strong><%= new Date(heroItem.end_at).toLocaleString() %></strong>
            </div>

            <div style="display:flex; gap: 36px; background: #171D2A; padding: 16px; border-radius: var(--aucp-radius-md); border: 1px solid var(--aucp-border); margin-bottom: 20px;">
              <div>
                <div style="font-size: 11px; text-transform: uppercase; color: var(--aucp-text-muted); font-weight: 700;">Current Highest Bid</div>
                <div style="font-size: 26px; font-weight: 800; color: var(--aucp-primary);">
                  ₦<%= parseFloat(heroItem.current_highest_bid).toLocaleString('en-NG', { minimumFractionDigits: 2 }) %>
                </div>
              </div>

              <div>
                <div style="font-size: 11px; text-transform: uppercase; color: var(--aucp-text-muted); font-weight: 700;">Current Highest Bid</div>
                <div style="font-size: 20px; font-weight: 700; color: var(--aucp-text-primary); margin-top: 4px;">
                  ₦<%= parseFloat(heroItem.current_highest_bid).toLocaleString('en-NG', { minimumFractionDigits: 2 }) %>
                </div>
              </div>
            </div>

            <div style="display:flex; gap: 12px;">
              <a href="/buyer/auction/<%= heroItem.id %>" class="aucp-btn aucp-btn-primary" style="padding: 12px 24px; font-size: 15px;">
                Place Bid Now &rarr;
              </a>
              <a href="/buyer/auction/<%= heroItem.id %>" class="aucp-btn aucp-btn-outline" style="padding: 12px 20px;">
                View Details
              </a>
            </div>
          </div>
        </div>
      <% } %>

      <!-- All Categories Tiles (Image 3 "All Categories" Tile Grid) -->
      <div style="margin-bottom: 32px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 16px;">
          <h2 style="font-size: 20px; font-weight: 800;">Explore Categories</h2>
          <a href="/buyer/browse" style="font-weight: 700; font-size: 13px;">View All &rarr;</a>
        </div>

        <div class="aucp-category-grid">
          <a href="/buyer/browse?category=Art+%26+Antiques" class="aucp-category-tile">
            <span class="aucp-category-icon"><i class="ti ti-palette"></i></span>
            <span class="aucp-category-name">Art & Antiques</span>
          </a>

          <a href="/buyer/browse?category=Electronics" class="aucp-category-tile">
            <span class="aucp-category-icon"><i class="ti ti-device-mobile"></i></span>
            <span class="aucp-category-name">Electronics</span>
          </a>

          <a href="/buyer/browse?category=Vehicles" class="aucp-category-tile">
            <span class="aucp-category-icon"><i class="ti ti-car"></i></span>
            <span class="aucp-category-name">Vehicles</span>
          </a>

          <a href="/buyer/browse?category=Cultural+Artifacts" class="aucp-category-tile">
            <span class="aucp-category-icon"><i class="ti ti-building-monument"></i></span>
            <span class="aucp-category-name">Cultural Artifacts</span>
          </a>
        </div>
      </div>

      <!-- Live Marketplace Auction Cards Grid (Image 2 & 3 Marketplace Grid) -->
      <div class="aucp-card" style="padding: 28px;">
        <div class="aucp-card-header">
          <h2 class="aucp-card-title"><i class="ti ti-flame" style="vertical-align: middle;"></i> Live Marketplace Auctions</h2>
          <a href="/buyer/browse" class="aucp-btn aucp-btn-outline aucp-btn-sm">View All (<%= liveAuctions.length %>)</a>
        </div>

        <div class="aucp-grid-3">
          <% if (liveAuctions.length === 0) { %>
            <div style="grid-column: span 3; text-align: center; color: var(--aucp-text-muted); padding: 32px;">
              No live auctions available at the moment.
            </div>
          <% } else { %>
            <% liveAuctions.forEach(item => { %>
              <div class="aucp-item-card">
                <div class="aucp-item-img-container">
                  <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; color: var(--aucp-text-muted);">
                    <i class="ti ti-photo" style="font-size: 36px;"></i>
                  </div>
                  <div style="position:absolute; top:10px; right:10px;">
                    <span class="aucp-badge aucp-badge-live">LIVE NOW</span>
                  </div>
                </div>

                <div style="margin-bottom: 8px;">
                  <span class="aucp-badge" style="background:#1E293B; color:#94A3B8;"><%= item.category %></span>
                </div>

                <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 8px; color: var(--aucp-text-primary);">
                  <a href="/buyer/auction/<%= item.id %>"><%= item.title %></a>
                </h3>

                <div style="background: #171D2A; padding: 12px; border-radius: var(--aucp-radius-sm); margin-top: auto; margin-bottom: 14px; border: 1px solid var(--aucp-border);">
                  <div style="font-size: 11px; text-transform: uppercase; color: var(--aucp-text-muted); font-weight: 700;">Current Highest Bid</div>
                  <div style="font-size: 20px; font-weight: 800; color: var(--aucp-primary);">
                    ₦<%= parseFloat(item.current_highest_bid).toLocaleString('en-NG', { minimumFractionDigits: 2 }) %>
                  </div>
                  <div style="font-size: 11px; color: var(--aucp-text-secondary); margin-top: 4px;">
                    Seller: <strong><%= item.seller_name %></strong>
                  </div>
                </div>

                <a href="/buyer/auction/<%= item.id %>" class="aucp-btn aucp-btn-primary aucp-btn-block">
                  Place Bid &rarr;
                </a>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>

    </div>
    <%- include('../partials/footer') %>
