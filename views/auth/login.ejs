<%- include('../partials/head', { title: 'Sign In – BidSecure Calabar' }) %>

<div class="aucp-auth-container">
  <div class="aucp-auth-box">
    <div style="text-align: center; margin-bottom: 20px;">
      <h1 style="font-size: 28px; font-weight: 800; color: var(--aucp-primary);"><i class="ti ti-shield-check" style="font-size: 32px; vertical-align: bottom;"></i> BidSecure</h1>
      <p class="aucp-auth-subtitle">Secure Online Auction Portal for Calabar</p>
    </div>

    <% if (error) { %>
      <div class="aucp-alert aucp-alert-danger">
        <%= error %>
      </div>
    <% } %>

    <% if (success) { %>
      <div class="aucp-alert aucp-alert-success">
        <%= success %>
      </div>
    <% } %>

    <form action="/login" method="POST">
      <input type="hidden" name="returnUrl" value="<%= returnUrl || '' %>">

      <div class="aucp-form-group">
        <label class="aucp-form-label" for="email">Email Address</label>
        <input type="email" id="email" name="email" class="aucp-form-input" placeholder="e.g. effiong@calabar.com" required autofocus>
      </div>

      <div class="aucp-form-group">
        <label class="aucp-form-label" for="password">Password</label>
        <input type="password" id="password" name="password" class="aucp-form-input" placeholder="password123" value="password123" required>
      </div>

      <button type="submit" class="aucp-btn aucp-btn-primary aucp-btn-block" style="margin-top: 10px;">
        Sign In to Portal
      </button>
    </form>

    <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--aucp-border); text-align: center; font-size: 14px;">
      <p style="color: var(--aucp-text-secondary);">Don't have a BidSecure account?</p>
      <a href="/register" style="font-weight: 700; margin-top: 4px; display: inline-block;">Create a New Account &rarr;</a>
    </div>

    <div style="margin-top: 20px; background-color: var(--aucp-bg); padding: 12px; border-radius: var(--aucp-radius-sm); font-size: 12px; color: var(--aucp-text-secondary);">
      <strong>Demo Test Credentials:</strong><br>
      • Admin: <code>admin@bidsecure.com</code> / <code>password123</code><br>
      • Buyer/Seller: <code>effiong@calabar.com</code> / <code>password123</code>
    </div>
  </div>
</div>

</body>
</html>
