<%- include('../partials/head', { title: 'Payment Confirmed – BidSecure' }) %>

<div class="aucp-layout">
  <%- include('../partials/sidebarBuyer', { activeTab: 'won' }) %>

  <div class="aucp-main-wrapper">
    <%- include('../partials/topbar', { pageHeader: 'Settlement Receipt' }) %>

    <div class="aucp-content">

      <div class="aucp-card" style="max-width: 650px; margin: 0 auto; border-color: var(--aucp-secondary);">
        <div style="text-align: center; margin-bottom: 24px;">
          <div style="font-size: 48px; margin-bottom: 8px;">✅</div>
          <span class="aucp-badge aucp-badge-active" style="font-size: 13px;">SETTLEMENT COMPLETED</span>
          <h1 style="font-size: 24px; font-weight: 800; margin-top: 8px;">Auction Payment Receipt</h1>
          <p style="font-size: 13px; color: var(--aucp-text-secondary);">Listing status has transitioned to SOLD.</p>
        </div>

        <div style="background: var(--aucp-bg); padding: 20px; border-radius: var(--aucp-radius-sm); margin-bottom: 24px;">
          <div class="aucp-grid-2" style="margin-bottom: 12px;">
            <div>
              <div style="font-size: 11px; text-transform: uppercase; color: var(--aucp-text-muted); font-weight: 700;">Item Title</div>
              <div style="font-weight: 700; font-size: 15px;"><%= transaction.listing_title %></div>
            </div>
            <div>
              <div style="font-size: 11px; text-transform: uppercase; color: var(--aucp-text-muted); font-weight: 700;">Amount Paid</div>
              <div style="font-weight: 800; font-size: 18px; color: var(--aucp-secondary);">₦<%= parseFloat(transaction.final_price).toLocaleString('en-NG', { minimumFractionDigits: 2 }) %></div>
            </div>
          </div>

          <div class="aucp-grid-2" style="margin-bottom: 0;">
            <div>
              <div style="font-size: 11px; text-transform: uppercase; color: var(--aucp-text-muted); font-weight: 700;">Seller Name</div>
              <div><%= transaction.seller_name %> (<%= transaction.seller_contact %>)</div>
            </div>
            <div>
              <div style="font-size: 11px; text-transform: uppercase; color: var(--aucp-text-muted); font-weight: 700;">Completion Date</div>
              <div><%= new Date(transaction.completed_at || transaction.created_at).toLocaleString() %></div>
            </div>
          </div>
        </div>

        <!-- Encryption Audit Block -->
        <div style="border: 1px dashed var(--aucp-border-dark); padding: 16px; border-radius: var(--aucp-radius-sm); margin-bottom: 24px; background: #FAFAFA;">
          <div style="font-size: 12px; font-weight: 700; color: var(--aucp-text-primary); margin-bottom: 8px;">
            🔒 Cryptographic Audit Proof (AES-256-GCM)
          </div>
          <div style="font-size: 12px; color: var(--aucp-text-secondary); margin-bottom: 8px;">
            Decrypted Payment Reference: <code><%= decryptedRef %></code>
          </div>
          <div style="font-size: 11px; color: var(--aucp-text-muted); word-break: break-all;">
            Encrypted Ciphertext at Rest (db.transactions):<br>
            <code><%= transaction.payment_reference_encrypted %></code>
          </div>
        </div>

        <div style="display:flex; gap: 12px;">
          <a href="/buyer/won-auctions" class="aucp-btn aucp-btn-primary aucp-btn-block">
            View My Won Auctions
          </a>
          <a href="/buyer/browse" class="aucp-btn aucp-btn-outline aucp-btn-block">
            Continue Browsing
          </a>
        </div>
      </div>

    </div>
    <%- include('../partials/footer') %>
