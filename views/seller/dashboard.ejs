<%- include('../partials/head', { title: 'Seller Dashboard – BidSecure' }) %>

<div class="aucp-layout">
  <%- include('../partials/sidebarSeller', { activeTab: 'seller-dashboard' }) %>

  <div class="aucp-main-wrapper">
    <%- include('../partials/topbar', { pageHeader: 'Seller Operations Center' }) %>

    <div class="aucp-content">

      <div class="aucp-grid-4">
        <div class="aucp-stat-card">
          <div class="aucp-stat-label">Active Listings</div>
          <div class="aucp-stat-value"><%= stats.activeListingsCount %></div>
          <div class="aucp-stat-subtext">Currently open for bidding</div>
        </div>

        <div class="aucp-stat-card">
          <div class="aucp-stat-label">Completed Sales</div>
          <div class="aucp-stat-value" style="color: var(--aucp-secondary);"><%= stats.completedSalesCount %></div>
          <div class="aucp-stat-subtext">Items successfully sold</div>
        </div>

        <div class="aucp-stat-card">
          <div class="aucp-stat-label">Gross Revenue</div>
          <div class="aucp-stat-value">₦<%= stats.totalRevenue.toLocaleString('en-NG', { minimumFractionDigits: 2 }) %></div>
          <div class="aucp-stat-subtext">Total sales value</div>
        </div>

        <div class="aucp-stat-card">
          <div class="aucp-stat-label">Draft Listings</div>
          <div class="aucp-stat-value" style="color: var(--aucp-warning);"><%= stats.draftListingsCount %></div>
          <div class="aucp-stat-subtext">Pending publishing</div>
        </div>
      </div>

      <!-- Seller Action Banner -->
      <div class="aucp-card" style="background-color: #DEF7EC; border-color: var(--aucp-secondary);">
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <div>
            <h2 style="font-size: 18px; font-weight: 700; color: var(--aucp-secondary-dark);">List a New Item for Auction</h2>
            <p style="color: var(--aucp-text-secondary); font-size: 14px;">Set item description, upload images, define starting price and reserve threshold.</p>
          </div>
          <a href="/seller/create-listing" class="aucp-btn aucp-btn-secondary">➕ Create Listing Now</a>
        </div>
      </div>

      <!-- Recent My Listings -->
      <div class="aucp-card">
        <div class="aucp-card-header">
          <h2 class="aucp-card-title">📦 My Auction Listings Overview</h2>
          <a href="/seller/my-listings" class="aucp-btn aucp-btn-outline aucp-btn-sm">View All Listings</a>
        </div>

        <div class="aucp-table-container">
          <table class="aucp-table">
            <thead>
              <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Starting Price</th>
                <th>Current Highest Bid</th>
                <th>Status</th>
                <th>End Date</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% if (listings.length === 0) { %>
                <tr>
                  <td colspan="7" style="text-align: center; color: var(--aucp-text-muted);">You have not created any auction listings yet.</td>
                </tr>
              <% } else { %>
                <% listings.forEach(item => { %>
                  <tr>
                    <td><strong><%= item.title %></strong></td>
                    <td><span class="aucp-badge" style="background:#E5E7EB; color:#374151;"><%= item.category %></span></td>
                    <td>₦<%= parseFloat(item.starting_price).toLocaleString('en-NG', { minimumFractionDigits: 2 }) %></td>
                    <td><strong style="color: var(--aucp-primary);">₦<%= parseFloat(item.current_highest_bid).toLocaleString('en-NG', { minimumFractionDigits: 2 }) %></strong></td>
                    <td>
                      <% if (item.status === 'active') { %>
                        <span class="aucp-badge aucp-badge-active">ACTIVE</span>
                      <% } else if (item.status === 'sold') { %>
                        <span class="aucp-badge aucp-badge-sold">SOLD</span>
                      <% } else if (item.status === 'draft') { %>
                        <span class="aucp-badge aucp-badge-draft">DRAFT</span>
                      <% } else { %>
                        <span class="aucp-badge aucp-badge-ended"><%= item.status.toUpperCase() %></span>
                      <% } %>
                    </td>
                    <td><%= new Date(item.end_at).toLocaleDateString() %></td>
                    <td>
                      <a href="/seller/listing-bids/<%= item.id %>" class="aucp-btn aucp-btn-outline aucp-btn-sm">
                        View Bids
                      </a>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
    <%- include('../partials/footer') %>
